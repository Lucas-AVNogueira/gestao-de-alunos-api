{
  "name": "gestao-de-alunos-api",
  "version": "1.0.0",
  "description": "API REST para gestão de alunos, disciplinas, notas e trabalhos, com banco de dados em memória.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "mocha --timeout 10000 \"test/**/*.test.js\"",
    "test:ci": "mocha --timeout 10000 \"test/**/*.test.js\" --reporter mochawesome --reporter-options reportDir=reports/mochawesome,reportFilename=index,html=true,json=false"
  },
